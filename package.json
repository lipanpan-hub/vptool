{
  "name": "@lppx/vptool",
  "description": "a cli tool for video process",
  "version": "0.0.6",
  "author": "lppx",
  "bin": {
    "vp": "./bin/run.js"
  },
  "bugs": "https://github.com/lipanpan-hub/vptool/issues",
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.2",
    "@inquirer/prompts": "^8.5.2",
    "@oclif/core": "^5.0.0",
    "@oclif/plugin-autocomplete": "^4.0.0",
    "@oclif/plugin-help": "^7.0.0",
    "@oclif/plugin-not-found": "^4.0.0",
    "@oclif/plugin-version": "^3.0.0",
    "@oclif/plugin-warn-if-update-available": "^4.0.0",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "pino": "^10.3.1",
    "pino-mongodb": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "pinyin-pro": "^3.28.1",
    "prompts": "^2.4.2",
    "yaml": "^2.9.0",
    "ytdlp-nodejs": "^3.4.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/prompts": "^2.4.9",
    "chai": "^4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^5.0.1",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/lipanpan-hub/vptool",
  "keywords": [
    "oclif"
  ],
  "license": "BSL",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "vp",
    "dirname": "vptool",
    "nsisCustomization": "nsis/nsis.nsi",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version"
    ],
    "topicSeparator": " ",
    "topics": {
      "help": {
        "description": "显示帮助信息"
      },
      "version": {
        "description": "显示版本信息"
      },
      "config": {
        "description": "查看与编辑用户配置文件（支持内置 TUI 与外部编辑器）"
      },
      "dl": {
        "description": "下载视频并管理本地依赖环境（基于 yt-dlp 与 ffmpeg）"
      },
      "dyd": {
        "description": "解析并下载抖音视频（可自动抽取音频）"
      },
      "fft": {
        "description": "基于 ffmpeg 的音视频处理（如从视频无损抽取音频）"
      },
      "vtt": {
        "description": "处理 VTT 字幕（单行压缩、按分段重新打时间戳等）"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init/inithook"
    }
  },
  "repository": "lipanpan-hub/vptool",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "start": "node ./bin/run.js",
    "debug": "cross-env DEBUG=oclif:vp:dl:* ./bin/run.js",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme --multi",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme --multi && git add README.md docs",
    "pack:tarballs": "oclif pack tarballs",
    "pack:win": "oclif pack win",
    "pack:macos": "oclif pack macos",
    "pack:deb": "oclif pack deb"
  },
  "types": "dist/index.d.ts"
}
